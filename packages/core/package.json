{
  "name": "@wasm-oj/core",
  "version": "0.2.4",
  "description": "Host-neutral compiler, runner, judge, dependency, and replay orchestration for WASM-OJ.",
  "license": "MIT",
  "author": "JacobLinCool",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wasm-oj/forge.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/wasm-oj/forge#readme",
  "bugs": {
    "url": "https://github.com/wasm-oj/forge/issues"
  },
  "keywords": [
    "online-judge",
    "wasi",
    "wasm"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses"
  ],
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "build": "node ../../scripts/build-library.mjs --package @wasm-oj/core",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@wasm-oj/contracts": "workspace:0.2.4",
    "fflate": "0.8.3"
  }
}
