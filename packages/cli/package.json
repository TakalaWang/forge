{
  "name": "@wasm-oj/cli",
  "version": "0.2.3",
  "description": "The local-first woj CLI for students and WASM-OJ Organizers.",
  "license": "MIT",
  "author": "JacobLinCool",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wasm-oj/forge.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/wasm-oj/forge#readme",
  "bugs": {
    "url": "https://github.com/wasm-oj/forge/issues"
  },
  "keywords": [
    "online-judge",
    "wasi",
    "cli"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "bin": {
    "woj": "./bin/woj.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses"
  ],
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "build": "node ../../scripts/build-library.mjs --package @wasm-oj/cli",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@napi-rs/keyring": "1.3.0",
    "@wasm-oj/core": "workspace:0.2.3",
    "@wasm-oj/organizer": "workspace:0.2.3",
    "@wasm-oj/server": "workspace:0.2.3"
  }
}
